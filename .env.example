# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional cron/worker secret for POST /api/outbox/process
OUTBOX_PROCESS_SECRET=change-me

# Optional cron/worker secret for POST /api/webhooks/process
WEBHOOK_PROCESS_SECRET=change-me

# Vercel Cron Jobs send this value as the Authorization bearer token
CRON_SECRET=change-me
