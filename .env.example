# OpenSlot local environment template.
# Copy this file to .env.local and replace placeholder values.

# Required: Supabase project configuration.
# NEXT_PUBLIC_* values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required: server-only service role key for trusted route handlers.
# Never expose this value in client components or public logs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required: public app origin for booking links and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production or worker testing: protects POST /api/outbox/process.
OUTBOX_PROCESS_SECRET=change-me

# Production or worker testing: protects POST /api/webhooks/process.
WEBHOOK_PROCESS_SECRET=change-me

# Production or worker testing: shared bearer token for Vercel Cron GET calls.
CRON_SECRET=change-me

# Optional calendar OAuth provider credentials.
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
MICROSOFT_CALENDAR_CLIENT_ID=your-microsoft-calendar-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=your-microsoft-calendar-client-secret
MICROSOFT_CALENDAR_TENANT=common

# Required when calendar integrations persist OAuth tokens.
# Use a stable high-entropy server-only value in production.
CALENDAR_TOKEN_ENCRYPTION_SECRET=change-me-to-at-least-32-random-bytes

# Production or worker testing: route-specific secret for /api/calendar/sync.
CALENDAR_SYNC_SECRET=change-me

# Optional: set to "stale" to live-check provider free/busy before confirming
# bookings when calendar cache or watch health is stale.
CALENDAR_FINAL_AVAILABILITY_CHECK=off
CALENDAR_STALE_AFTER_MINUTES=10

# Email delivery. Leave EMAIL_PROVIDER unset or set to console for local logs.
# Real providers require EMAIL_FROM plus the matching provider API key.
EMAIL_PROVIDER=console
EMAIL_FROM="OpenSlot <bookings@example.com>"
RESEND_API_KEY=your-resend-api-key
MAILEROO_API_KEY=your-maileroo-api-key
